__d(function(g,_r,_i,a,m,_e,d){var e=_r(d[0]);Object.defineProperty(_e,"__esModule",{value:!0}),_e.default=void 0;var t=e(_r(d[1])),o=s(_r(d[2])),r=_r(d[3]),n=s(_r(d[4])),i=e(_r(d[5]));function s(e,t){if("function"==typeof WeakMap)var o=new WeakMap,r=new WeakMap;return(s=function(e,t){if(!t&&e&&e.__esModule)return e;var n,i,s={__proto__:null,default:e};if(null===e||"object"!=typeof e&&"function"!=typeof e)return s;if(n=t?r:o){if(n.has(e))return n.get(e);n.set(e,s)}for(var l in e)"default"!==l&&{}.hasOwnProperty.call(e,l)&&((i=(n=Object.defineProperty)&&Object.getOwnPropertyDescriptor(e,l))&&(i.get||i.set)?n(s,l,i):s[l]=e[l]);return s})(e,t)}var l={orange:'#FC4603',orangeLight:'#FFF0E8',green:'#1BA672',greenLight:'#E8F8F1',ink:'#282C3F',gray:'#686B78',muted:'#93959F',border:'#E9E9EB',bg:'#F8F8F8',white:_r(d[6]).tokens.colors.surface},c=()=>i.default.trigger('impactLight',{enableVibrateFallback:!0}),u=[{category:'Earnings & Payouts',items:[{q:'How are my earnings calculated?',a:'You earn a base pay per delivery plus a distance bonus (\u20b95 per km beyond 2 km). Tips from customers are added on top. A 10% platform fee is deducted. Your net earnings are credited to your daily earnings dashboard in real time after every delivery.'},{q:'When do I get paid?',a:'Earnings are transferred automatically every night at 11:45 PM to your registered UPI ID. Make sure your UPI is set up in the Payouts screen. You can also request a manual payout anytime if your pending balance is \u20b9100 or more.'},{q:'How do I add or update my UPI ID?',a:'Go to Profile \u2192 Payouts \u2192 tap the UPI section. Enter your UPI ID (e.g. yourname@okaxis) and tap Save. Once saved, auto-pay will activate and you\'ll receive earnings every night without any manual action.'},{q:'Why hasn\'t my payout arrived yet?',a:'Auto-pay runs at 11:45 PM daily. Bank transfers can take up to 2 hours to reflect depending on your bank. If it\'s been more than 4 hours, contact support with your UPI ID and we\'ll investigate.'},{q:'What are tips and where can I see them?',a:'Customers can optionally add a tip at checkout. Tips are credited directly to your earnings for that order. You can see tip amounts in your Order History screen \u2014 any order with a tip shows it with an amber badge.'}]},{category:'Deliveries',items:[{q:'What do I do if the customer is unreachable?',a:'Tap "Customer Unreachable" on the delivery screen. You\'ll have 3 options: Retry calling, Leave at Door (with a photo), or Return the order to the kitchen. Always try calling at least twice before choosing Leave at Door.'},{q:'How do I report an issue with an order?',a:'Tap "Report Issue" on the active order screen. You can select from common issues \u2014 Missing Items, Wrong Order, Damaged Package, Customer Refused, or Other. Add a note if needed. Our team reviews all reports within 1 hour.'},{q:'What if the restaurant/kitchen doesn\'t have the order ready?',a:'Wait at the kitchen for up to 10 minutes. If the order is still not ready, use Report Issue \u2192 "Order Not Ready at Kitchen". Do not leave without the order \u2014 it affects your completion rate.'},{q:'What is COD and how do I handle it?',a:'Cash on Delivery (COD) means the customer pays in cash or UPI at the door. Show them the QR code for UPI payment or collect cash. Once payment is done, tap the confirm button. You\'ll need to submit COD cash to the finance desk at the kitchen.'},{q:'How does the delivery OTP work?',a:'The customer receives a 4-digit OTP when the order is out for delivery. Ask the customer for their OTP and enter it in the app to confirm delivery. This protects both you and the customer. You can also take a POD (Proof of Delivery) photo.'}]},{category:'Documents & Account',items:[{q:'How long does document verification take?',a:'Our team verifies documents within 24-48 hours of submission. You\'ll receive a notification once approved or if anything needs to be re-uploaded. You can check status anytime in Profile \u2192 Documents.'},{q:'My documents were rejected \u2014 what now?',a:'Go to Profile \u2192 Documents to see the rejection reason. Common reasons: blurry photo, expired license, wrong document uploaded. Re-upload a clear photo of the correct document and resubmit.'},{q:'Can I change my registered vehicle?',a:'Yes. Go to Profile \u2192 Documents and update your vehicle type and license number, then upload the new documents. Your account may be temporarily suspended during re-verification.'},{q:'Why has my account been suspended?',a:'Accounts are suspended for policy violations, document issues, or customer complaints. You would have received a notification with the reason. Contact support to appeal or resolve the issue.'}]},{category:'App & Navigation',items:[{q:'I\'m not receiving any orders \u2014 what\'s wrong?',a:'Make sure you\'re set to Online (green toggle on the home screen). Check that your location permissions are set to "Always" in phone settings. Orders are assigned based on your proximity to kitchens \u2014 try moving to a busier area.'},{q:'The map or navigation isn\'t working',a:'The app uses Google Maps for navigation. Make sure Google Maps is installed and location permissions are granted for both Google Maps and this app. Tap the blue map button on the order screen to open navigation.'},{q:'App is crashing or running slowly',a:'Force-close and reopen the app. If it continues, clear the app cache from your phone settings. Make sure you\'re on the latest app version. If the problem persists, raise a support ticket.'},{q:'How do I go offline / take a break?',a:'Tap the Online/Offline toggle on the home screen to go offline. You won\'t receive new order assignments while offline. Any order already accepted must be completed before going offline.'}]}],h=({item:e,idx:i})=>{var s=(0,o.useState)(!1),u=(0,t.default)(s,2),h=u[0],y=u[1];return(0,_r(d[7]).jsxs)(n.default.View,{entering:n.FadeInDown.delay(30*i).duration(200),style:p.faqItem,children:[(0,_r(d[7]).jsxs)(_r(d[