# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'VeltoMobile' do
  # Disable VisionCamera frame processors — the app only uses useCodeScanner (QR scanning).
  # Without this, VisionCamera auto-enables frame processors because react-native-worklets-core
  # is present, which pulls in FrameHostObject.mm that references Fabric C++ debug symbols
  # (ShadowNode::getDebugName, BaseViewProps vtable, etc.) not exported by RN 0.76's
  # prebuilt xcframeworks, causing "Undefined symbol: facebook::react::" linker errors.
  $VCEnableFrameProcessors = false

  config = use_native_modules!
  use_modular_headers!
  
  # Force Firebase pods to build as static frameworks.
  # This resolves the <FirebaseAuth/FirebaseAuth-Swift.h> not found error,
  # without needing `use_frameworks!` which breaks C++ pods (lottie, jsi).
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name.start_with?('Firebase') || pod.name.start_with?('Google') || pod.name == 'RecaptchaInterop'
        def pod.build_type;
          Pod::BuildType.static_framework
        end
      end
    end
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Google Maps for iOS — required so react-native-maps compiles with HAVE_GOOGLE_MAPS=1
  # and MapView with provider={PROVIDER_GOOGLE} actually renders on iOS.
  # Versions must match what react-native-maps 1.27.2 expects in its podspec.
  pod 'GoogleMaps', '9.4.0'
  pod 'Google-Maps-iOS-Utils', '6.1.0'
  
  # Explicitly include the Google subspec of react-native-maps
  pod 'react-native-maps', path: '../node_modules/react-native-maps', subspecs: ['Google']

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Automatically add a dummy Swift file to enable Swift compilation for the main target
    # This is required for Firebase Swift headers (FirebaseAuth-Swift.h) to be found
    # when not using use_frameworks!
    project_path = installer.sandbox.project_path.to_s.gsub('Pods/Pods.xcodeproj', 'VeltoMobile.xcodeproj')
    project = Xcodeproj::Project.open(project_path)
    target = project.targets.find { |t| t.name == 'VeltoMobile' }
    if target
      dummy_swift_path = File.join(File.dirname(project_path), 'VeltoMobile', 'Dummy.swift')
      File.write(dummy_swift_path, "// Dummy Swift file to enable Swift compiler in Xcode\nimport Foundation\n")
      group = project.main_group.find_subpath('VeltoMobile', true)
      unless group.files.any? { |file| file.path == 'Dummy.swift' }
        file_reference = group.new_reference(dummy_swift_path)
        target.source_build_phase.add_file_reference(file_reference)
      end
      target.build_configurations.each do |c|
        c.build_settings['SWIFT_VERSION'] = '5.0'
      end
      project.save
    end

    # react-native-worklets-core needs the codegen-generated RNWorkletsSpec.h
    # header at compile time. In RN 0.74+ the file lives inside the
    # React-Codegen framework, which isn't always on the search path for
    # third-party pods when they compile before the framework is fully staged.
    # Adding both possible locations covers Debug/Release on device/simulator.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end

      if target.name == 'RNWorklets'
        target.build_configurations.each do |config|
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_CONFIGURATION_BUILD_DIR}/ReactCodegen/ReactCodegen.framework/Headers"'

          # react-native-worklets-core is compiled in Debug mode with
          # RN_DEBUG_STRING_CONVERTIBLE set, which makes it reference virtual debug
          # methods on ShadowNode/DebugStringConvertible that are absent from the
          # prebuilt Release libReact-Fabric.a — causing "Undefined symbol" linker
          # errors.  Undefining the flag here makes the pod see the same lean class
          # layout the prebuilt was compiled with, so no debug-symbol references are
          # generated and no stub vtables are needed.
          flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{flags} -URN_DEBUG_STRING_CONVERTIBLE"
        end
      end
    end
  end
end
