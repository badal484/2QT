# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/velto

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (REQUIRED — server will crash on startup if missing) ────────────────
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-strong-random-refresh-secret-min-32-chars

# ─── Razorpay (payments + RazorpayX payouts) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ACCOUNT_NUMBER=4564563456345634   # RazorpayX account number for payouts

# ─── Firebase (push notifications) ────────────────────────────────────────────
# Use ONE of these two forms (B64 is preferred for env vars with newlines)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_service_account_json

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ─── SMS / OTP (MSG91) ────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_FLOW_ID=your_msg91_flow_id        # SMS flow/template ID for transactional messages
MSG91_SENDER_ID=your_msg91_sender_id    # 6-char sender ID (e.g. VLTFPD)

# ─── WhatsApp (Interakt) ──────────────────────────────────────────────────────
INTERAKT_API_KEY=your_interakt_api_key

# ─── Exotel (IVR / voice OTP fallback) ───────────────────────────────────────
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=your_exotel_virtual_number

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── ImageKit (media uploads) ─────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_KEY=your_google_maps_api_key   # alias used by distance.service.ts; set both to same value

# ─── Business / Legal ─────────────────────────────────────────────────────────
FSSAI_LICENSE=your_fssai_license_number
GSTIN=your_gstin
BACKEND_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com

# ─── Support contacts ─────────────────────────────────────────────────────────
ADMIN_PHONE=+91xxxxxxxxxx
ADMIN_WHATSAPP=+91xxxxxxxxxx
SUPPORT_WHATSAPP_NUMBER=+91xxxxxxxxxx

# ─── Internal tooling ─────────────────────────────────────────────────────────
BULL_BOARD_PASSWORD=change-me-in-production    # /admin/queues HTTP basic auth
BACKEND_SELF_URL=http://localhost:3000/api/v1/health   # cron health-check self-ping

# ─── Development only ─────────────────────────────────────────────────────────
TEST_DELIVERY_OTP=654321    # bypass OTP for dev testing — never set in production
