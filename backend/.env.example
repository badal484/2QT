# 2QT now runs as two Cloud Run services from this one codebase — see src/index.ts
# (API: Express + Socket.IO, autoscaling) and src/worker.ts (Worker: BullMQ + node-cron,
# pinned to exactly 1 instance). Each variable below is tagged with which service(s)
# actually read it at runtime, so you know what to set on each Cloud Run service /
# Secret Manager binding. [BOTH] means both services need it set.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development                        # [BOTH]
PORT=3000                                   # [BOTH] — Cloud Run injects this per-service; local dev only needs to differ if running both at once

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/velto   # [BOTH]

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379            # [BOTH]

# ─── Auth (REQUIRED — server will crash on startup if missing) ────────────────
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars              # [BOTH] — also required by the worker because it shares src/socket/index.ts (the Redis-backed emitter), even though the worker never verifies a token itself
JWT_REFRESH_SECRET=your-strong-random-refresh-secret-min-32-chars  # [API only]

# ─── Razorpay (payments + RazorpayX payouts) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx                # [API only] — order creation, payment verification
RAZORPAY_KEY_SECRET=your_razorpay_key_secret          # [API only]
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret  # [API only] — webhook signature check
RAZORPAY_ACCOUNT_NUMBER=4564563456345634    # [WORKER only] — RazorpayX payouts fire from the payout crons

# ─── Firebase (Auth — phone-login OTP token verification) ────────────────────
# Use ONE of these two forms (B64 is preferred for env vars with newlines)
# [API only] — used by routes/prelaunch.ts / config/firebaseAdmin.ts to verify Firebase
# Auth ID tokens on phone login.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_service_account_json

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx        # [BOTH] — both entry points tag events with service=api / service=worker

# ─── SMS / OTP (MSG91) ────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key          # [API only] — OTP send is a request-time flow
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_FLOW_ID=your_msg91_flow_id        # SMS flow/template ID for transactional messages — [WORKER] notification jobs
MSG91_SENDER_ID=your_msg91_sender_id    # 6-char sender ID (e.g. VLTFPD) — [WORKER]

# ─── WhatsApp (Interakt) ──────────────────────────────────────────────────────
INTERAKT_API_KEY=your_interakt_api_key      # [WORKER] — sent via notification jobs

# ─── Exotel (IVR / voice OTP fallback) ───────────────────────────────────────
EXOTEL_ACCOUNT_SID=your_exotel_sid          # [API only]
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=your_exotel_virtual_number

# ─── ImageKit (media uploads) ─────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key    # [API only] — uploads are request-time
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key    # [API only] — distance lookup during checkout
GOOGLE_MAPS_KEY=your_google_maps_api_key   # alias used by distance.service.ts; set both to same value — [API only]. The worker imports this module too (for the unrelated haversineMetres helper) but never calls the part that needs this key, so it's safe to leave unset on the worker service.

# ─── Business / Legal ─────────────────────────────────────────────────────────
FSSAI_LICENSE=your_fssai_license_number     # [API only]
GSTIN=your_gstin
BACKEND_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com   # [API only] — CORS allowlist

# ─── Support contacts ─────────────────────────────────────────────────────────
ADMIN_PHONE=+91xxxxxxxxxx                   # [WORKER] — used by notification/alert jobs
ADMIN_WHATSAPP=+91xxxxxxxxxx
SUPPORT_WHATSAPP_NUMBER=+91xxxxxxxxxx

# ─── Internal tooling ─────────────────────────────────────────────────────────
BULL_BOARD_PASSWORD=change-me-in-production    # [API only] — /admin/queues HTTP basic auth (Bull Board reads queue state from Redis; it does not need to run in the worker process)
BACKEND_SELF_URL=http://localhost:3000/api/v1/health   # [WORKER] — the "keep Render warm" self-ping cron; irrelevant on Cloud Run, safe to leave unset (see audit §5)

# ─── Development only ─────────────────────────────────────────────────────────
TEST_DELIVERY_OTP=654321    # bypass OTP for dev testing — never set in production — [API only]
