# ─── PRODUCTION ENV TEMPLATE ─────────────────────────────────────────────────
# Copy this to /opt/velto/.env.prod on the EC2 server and fill in real values.
# NEVER commit .env.prod to git.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ─── Database (RDS PostgreSQL) ───────────────────────────────────────────────
# Replace <endpoint> with your RDS instance endpoint from AWS console
DATABASE_URL=postgresql://velto:<password>@<endpoint>.ap-south-1.rds.amazonaws.com:5432/velto

# ─── Redis (Docker container — set by docker-compose.aws.yml) ────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ─── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_B64=<base64 of service-account.json>

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── SMS / OTP (MSG91) ───────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# ─── WhatsApp (Interakt) ─────────────────────────────────────────────────────
INTERAKT_API_KEY=

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── ImageKit ────────────────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_KEY=

# ─── Business / Legal ────────────────────────────────────────────────────────
FSSAI_LICENSE=
GSTIN=
BACKEND_URL=https://api.go2qt.com
ALLOWED_ORIGINS=https://go2qt.com,https://www.go2qt.com,https://admin.go2qt.com

# ─── Support ─────────────────────────────────────────────────────────────────
ADMIN_PHONE=+916204646300
ADMIN_WHATSAPP=+916204646300
SUPPORT_WHATSAPP_NUMBER=916204646300

# ─── Internal ────────────────────────────────────────────────────────────────
BULL_BOARD_PASSWORD=<set a strong password>
BACKEND_SELF_URL=https://api.go2qt.com/api/v1/health
