between gap-4\"><p class=\"text-sm font-semibold transition-colors text-zinc-900\">What if my order is wrong or missing items?</p><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button><button class=\"w-full text-left px-6 py-4 hover:bg-zinc-50 transition-colors\"><div class=\"flex items-center justify-between gap-4\"><p class=\"text-sm font-semibold transition-colors text-zinc-900\">Can I reorder a past order?</p><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button><button class=\"w-full text-left px-6 py-4 hover:bg-zinc-50 transition-colors\"><div class=\"flex items-center justify-between gap-4\"><p class=\"text-sm font-semibold transition-colors text-zinc-900\">What is the estimated delivery time?</p><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div></div><div class=\"bg-white rounded-3xl border border-zinc-200 overflow-hidden shadow-sm\"><div class=\"flex items-center gap-3 px-6 py-5 border-b border-zinc-100\"><div class=\"w-9 h-9 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-pri