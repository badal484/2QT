\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"Delivery riders:\"}],\" Your name, phone number (masked), and delivery address for order fulfilment.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"Kitchen partners:\"}],\" Your order details (no personal contact info) for preparation.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"Payment processor (Razorpay):\"}],\" For transaction processing, governed by Razorpay's privacy policy.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"Communication providers (MSG91, Interakt):\"}],\" Your phone number, for OTP and WhatsApp order notifications.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"Firebase (Google):\"}],\" For authentication and push notifications.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-300\",\"children\":\"ImageKit:\"}],\" For image hosting and delivery.\"]}],\"$L15\"]}]]}],\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}]\nd:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0i9ky7uu~7o~..js\",\"async\":true,\"nonce\":\"$undefined\"}]\ne:[\"$\",\"$L1e\",null,{\"children\":[\"$\",\"$1f\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@20\"}]}]\n21:[]\nf:\"$W21\"\n10:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L22\",null,{\"children\":\"$L23\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L24\",null,{\"children\":[\"$\",\"$1f\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L25\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n12:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0s0ygcl-1ao1n.css\",\"precedence\":\"next\",\"crossOrigin\":\